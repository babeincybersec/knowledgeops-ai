# ================================================================
# LLM PROVIDER
# ================================================================
# Which company provides the LLM. Options: openai | anthropic | google
LLM_PROVIDER=openai

# Which specific model. Cheapest good option:
LLM_MODEL=gpt-4o-mini

# ================================================================
# API KEYS
# ================================================================
# Get yours at: https://platform.openai.com/api-keys
# Format: starts with "sk-", about 50 characters long
# This is REQUIRED for Milestone 3 (LLM answers)
OPENAI_API_KEY=sk-OPENAI_API_KEY

# Only needed if LLM_PROVIDER=anthropic
# Get at: https://console.anthropic.com/
# Format: starts with "sk-ant-"
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed if LLM_PROVIDER=google
# Get at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# ================================================================
# EMBEDDINGS
# ================================================================
# Local model — free, runs on your machine, no key needed.
# Leave this as-is for your Dell 8GB machine.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ================================================================
# VECTOR DATABASE
# ================================================================
# Where ChromaDB stores its files locally
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=knowledgeops

# ================================================================
# RETRIEVAL SETTINGS
# ================================================================
# How many document chunks to retrieve per question
TOP_K=5

# Chunk size in characters (800 = about 150 words)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ================================================================
# APPLICATION
# ================================================================
# development | staging | production
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ================================================================
# API SERVER
# ================================================================
API_HOST=0.0.0.0
API_PORT=8000